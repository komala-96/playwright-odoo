# Copy to .env and fill in. .env is git-ignored.
BASE_URL=https://martiserv.averigoqa.com
AVERIGO_USERNAME=
AVERIGO_PASSWORD=

# Optional: base32 TOTP secret of the QA user (shown as "secret" when 2FA is
# enabled). When set, the OTP is generated automatically and login is fully
# headless. When empty, a headed browser opens once and waits for you to type
# the OTP; the trusted-device cookie is then reused so OTP is not asked again.
TOTP_SECRET=
OTP_WAIT_MS=180000

# Optional: reuse a previous run's data/state (e.g. to re-run a single spec).
# RUN_ID=
TESTER=QA Automation
